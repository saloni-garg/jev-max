# Pick ONE provider for Jev decisions. Keys are never committed.
# TypeSafe (https://docs.typesafe.ai)
TYPESAFE_API_KEY=
# ...or OpenRouter (https://openrouter.ai) which also serves Jev
OPENROUTER_API_KEY=

# Small LLM used ONLY to generate text for TYPE_TEXT actions (and canvas grounding).
# Any OpenAI-compatible endpoint works. Example default below is just a suggestion.
TEXT_MODEL_API_KEY=
TEXT_MODEL_NAME=inception/mercury-2.5
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
